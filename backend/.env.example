# --- runtime ---
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins (CORS, credentials enabled)
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
SWAGGER_ENABLED=true

# --- persistence ---
# mongo (default) | memory (tests / quick demo only - data is lost on restart)
DB_DRIVER=mongo
MONGODB_URI=mongodb://localhost:27017/easygenerator-auth

# --- auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_REFRESH_TTL=7d
# Set true behind HTTPS (production). false lets the cookie work on http://localhost
COOKIE_SECURE=false

# --- rate limiting (per IP, on /auth/*) ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10
